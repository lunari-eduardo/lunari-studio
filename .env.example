# ─── Supabase ────────────────────────────────────────────────────────────────
# (copiados do Supabase Dashboard > Project Settings > API)
SUPABASE_URL="https://<project>.supabase.co"
VITE_SUPABASE_URL="https://<project>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon/public key>"
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# ─── Site ─────────────────────────────────────────────────────────────────────
VITE_SITE_URL="https://app.lunarihub.com"

# ─── Cloudflare Workers ────────────────────────────────────────────────────────
# URLs dos workers (depois do deploy)
VITE_EDGE_PREVIEWS_URL="https://lunari-edge-previews.<account>.workers.dev"
VITE_EDGE_API_URL="https://lunari-edge-api.<account>.workers.dev"

# ─── Evolution API (WhatsApp via Evolution API v2 — Hostinger VPS Brasil) ────
# URL base da Evolution API (Swagger: https://wpp.lunarihub.com/docs)
VITE_EVOLUTION_API_URL="https://wpp.lunarihub.com"
VITE_EVOLUTION_INSTANCE_NAME="lunari-default"
VITE_EVOLUTION_WEBHOOK_SECRET="9a3e7b1d5c2f8a0e4b6d8c1f3a5e7d2b"

# Segredos — configurar via `wrangler secret put`:
#   EVOLUTION_API_KEY="4f8a9e2b1c7d3f0a8e5b6c7d9a1f2e3d4c5b6a7e8f90123456789abcdef0"
#   EVOLUTION_WEBHOOK_SECRET="9a3e7b1d5c2f8a0e4b6d8c1f3a5e7d2b"
#   SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
#   SUPABASE_URL="https://tlnjspsywycbudhewsfv.supabase.co"

# ─── Gateway de Pagamento ──────────────────────────────────────────────────────
# (mantidos conforme já existentes no projeto)
VITE_MERCADOPAGO_APP_ID="<mp-app-id>"
VITE_FEATURE_COMBINED_CHARGE="true"

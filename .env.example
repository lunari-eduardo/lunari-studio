# ─── Supabase ────────────────────────────────────────────────────────────────
# (copiados do Supabase Dashboard > Project Settings > API)
SUPABASE_URL="https://<project>.supabase.co"
VITE_SUPABASE_URL="https://<project>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon/public key>"
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# ─── Site ─────────────────────────────────────────────────────────────────────
VITE_SITE_URL="https://app.lunarihub.com"

# ─── Cloudflare Workers ────────────────────────────────────────────────────────
# URLs dos workers (depois do deploy)
VITE_EDGE_PREVIEWS_URL="https://lunari-edge-previews.<account>.workers.dev"
VITE_EDGE_API_URL="https://lunari-edge-api.<account>.workers.dev"

# ─── Evolution API (WhatsApp via Evolution API) ────────────────────────────────
# Configurar após instalar a Evolution API na VPS Contabo.
# NUNCA exponha estas variáveis no frontend (VITE_ prefixo apenas para referência local).

# URL base da instância da Evolution API
# Ex.: http://<vps-ip>:8080  ou  https://evolution.seu-dominio.com
VITE_EVOLUTION_API_URL="http://<vps-ip>:8080"
VITE_EVOLUTION_INSTANCE_NAME="lunari-default"

# Segredo do webhook (configurado na Evolution API e aqui para validar HMAC)
VITE_EVOLUTION_WEBHOOK_SECRET="<webhook-secret>"

# Variáveis que NÃO devem ter VITE_ (são secretos de servidor):
# No .env (NÃO comitar!):
#   EVOLUTION_API_KEY="<api-key-da-instancia>"
#   EVOLUTION_API_URL="http://<vps-ip>:8080"
#   EVOLUTION_WEBHOOK_SECRET="<secret>"
#   SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
# Configurar via `wrangler secret put` no Cloudflare:
#   wrangler secret put EVOLUTION_API_KEY
#   wrangler secret put EVOLUTION_WEBHOOK_SECRET
#   wrangler secret put SUPABASE_SERVICE_ROLE_KEY
#   wrangler secret put SUPABASE_URL

# ─── Gateway de Pagamento ──────────────────────────────────────────────────────
# (mantidos conforme já existentes no projeto)
VITE_MERCADOPAGO_APP_ID="<mp-app-id>"
VITE_FEATURE_COMBINED_CHARGE="true"

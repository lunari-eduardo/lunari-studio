# ─── Supabase ────────────────────────────────────────────────────────────────
# (copiados do Supabase Dashboard > Project Settings > API)
SUPABASE_URL="https://<project>.supabase.co"
VITE_SUPABASE_URL="https://<project>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon/public key>"
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# ─── Site ─────────────────────────────────────────────────────────────────────
VITE_SITE_URL="https://app.lunarihub.com"

# ─── Cloudflare Workers ────────────────────────────────────────────────────────
# URLs dos workers (depois do deploy)
VITE_EDGE_PREVIEWS_URL="https://lunari-edge-previews.<account>.workers.dev"
VITE_EDGE_API_URL="https://lunari-edge-api.<account>.workers.dev"

# ─── Edge Worker (lê EVOLUTION_API_KEY no servidor, NUNCA no frontend) ────────
# URL pública do Worker que faz proxy para a Evolution API.
# Todas as chamadas autenticadas a partir do frontend passam por aqui.
VITE_WORKER_URL="https://lunari-edge-api.eduardo22diehl.workers.dev"

# ─── Evolution API (WhatsApp via Evolution API v2 — Hostinger VPS Brasil) ────
# URL base da Evolution API (usada apenas pelo Worker; NÃO usar no frontend)
# (Swagger: https://wpp.lunarihub.com/docs)
# ATENÇÃO: EVOLUTION_API_URL e EVOLUTION_API_KEY são LIDOS PELO WORKER via wrangler.toml
# e via `wrangler secret put`. O frontend nunca deve importar essas variáveis.
# VITE_EVOLUTION_API_URL é mantido aqui apenas como referência histórica — remova do bundle.


# ─── Gateway de Pagamento ──────────────────────────────────────────────────────
# (mantidos conforme já existentes no projeto)
VITE_MERCADOPAGO_APP_ID="<mp-app-id>"
VITE_FEATURE_COMBINED_CHARGE="true"
